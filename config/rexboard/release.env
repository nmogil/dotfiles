# Pinned rexboard release for Linux (x86_64). Data only: read by
# scripts/setup-rexboard.sh, never sourced. See docs/rexboard.md.
# Upstream: https://github.com/vanducng/rexboard (MIT). The release has no
# GitHub attestation; both checksums below were checked against the release's
# SHA256SUMS and against the binary already running on the VPS.
REXBOARD_VERSION=0.36.0
REXBOARD_RELEASE_URL=https://github.com/vanducng/rexboard/releases/download/v0.36.0
REXBOARD_LINUX_X86_64_ARCHIVE=rexboard-v0.36.0-x86_64-unknown-linux-gnu.tar.gz
REXBOARD_LINUX_X86_64_ARCHIVE_SHA256=f3b28d02bfdbc7541db409855fd2dc50d4ca486e59d26f439b268bf77a9ffae8
REXBOARD_LINUX_X86_64_BINARY_SHA256=00a6847d8859f8fc9352a32398f6d9b7c9056dab13370cfca36e8d24e302580e
# macOS uses Homebrew (see Brewfile); Homebrew manages that version.
REXBOARD_BREW_FORMULA=vanducng/tap/rexboard
