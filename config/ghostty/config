# Ghostty config. Reload live with cmd+shift+,
# Docs: https://ghostty.org/docs/config

# --- Font ---
font-family = "MesloLGS NF"
font-size = 12

# --- Window / background ---
background = 000000
background-opacity = 0.92
background-blur = true
unfocused-split-opacity = 0.55
window-height = 998
window-width = 3840
window-save-state = always
macos-titlebar-style = transparent

# --- macOS keyboard / UX ---
macos-option-as-alt = true
mouse-hide-while-typing = true
copy-on-select = clipboard
clipboard-trim-trailing-spaces = true

# --- Shell integration (sudo + title are off by default) ---
shell-integration-features = cursor,sudo,title

# --- Splits ---
keybind = cmd+/=new_split:right
keybind = cmd+.=new_split:down
keybind = cmd+alt+left=goto_split:left
keybind = cmd+alt+right=goto_split:right
keybind = cmd+alt+up=goto_split:up
keybind = cmd+alt+down=goto_split:down

# --- Quick dropdown terminal (global hotkey) ---
keybind = global:cmd+grave_accent=toggle_quick_terminal
