# Pi workspace runtime/state — never track these in the dotfiles repo.
node_modules/
dist/
*.log

# Live/runtime config derived from the examples. Copy the *.example.json files
# to these names locally; keep the real ones out of git (they may hold provider
# endpoints, package paths, tokens, and machine-specific preferences).
agent/settings.json
agent/models.json
agent/mcp.json
agent/memory-compiler.json

# Auth / session / cache state written by the pi CLI at runtime.
agent/auth.json
agent/session*
agent/.cache/
