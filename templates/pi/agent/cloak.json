{
  "$comment": "Cloak masks secret-looking strings in the Pi TUI/logs. These are GENERIC name/shape patterns only — no real secrets. Edit to taste.",
  "enabled": true,
  "mask": "••••••••",
  "patterns": [
    { "name": "env-secret-assignment", "regex": "(?i)\\b([A-Z0-9_]*(TOKEN|SECRET|PASSWORD|PASSWD|API[_-]?KEY|ACCESS[_-]?KEY|PRIVATE[_-]?KEY)[A-Z0-9_]*)\\s*[=:]\\s*\\S+" },
    { "name": "bearer-header", "regex": "(?i)\\bBearer\\s+[A-Za-z0-9._~+/=-]{8,}" },
    { "name": "authorization-header", "regex": "(?i)\\bAuthorization\\s*:\\s*\\S+" },
    { "name": "anthropic-key", "regex": "sk-ant-[A-Za-z0-9_-]{16,}" },
    { "name": "openai-key", "regex": "sk-[A-Za-z0-9]{20,}" },
    { "name": "github-token", "regex": "gh[pousr]_[A-Za-z0-9]{20,}" },
    { "name": "aws-access-key-id", "regex": "AKIA[0-9A-Z]{16}" },
    { "name": "private-key-block", "regex": "-----BEGIN [A-Z ]*PRIVATE KEY-----" }
  ]
}
