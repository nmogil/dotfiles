#!/usr/bin/env bash
# dot — control surface for this dotfiles repo. Thin wrapper around the existing
# scripts; it locates them and dispatches, it does not duplicate their logic.
set -euo pipefail

script_path() {
  local src="${BASH_SOURCE[0]}"
  while [ -L "$src" ]; do
    local dir
    dir="$(cd -P "$(dirname "$src")" && pwd)"
    src="$(readlink "$src")"
    [[ "$src" != /* ]] && src="$dir/$src"
  done
  cd -P "$(dirname "$src")" && pwd
}

# Repo root = dir this script lives in, resolving symlinks portably enough for
# Linux and macOS so `dot` can later be linked onto PATH.
DOT_ROOT="$(script_path)"

# Optional local config layer (defines functions only; no side effects at source
# time). Lets pi_doctor honor DOTFILES_PI_BLOCKLIST from ~/.config/dotfiles/local.env.
# shellcheck source=scripts/lib/local-env.sh
[ -f "$DOT_ROOT/scripts/lib/local-env.sh" ] && . "$DOT_ROOT/scripts/lib/local-env.sh"

run() {  # run <script> [args...] — fail clearly if the script is missing
  local script="$DOT_ROOT/$1"; shift
  [ -f "$script" ] || { echo "dot: missing script: $script" >&2; exit 1; }
  exec bash "$script" "$@"
}

usage() {
  cat <<'EOF'
dot — dotfiles control surface

Usage: ./dot <command> [args]

  help                 Show this help
  doctor               Read-only environment health check
  setup mac            Run macOS setup (setup.sh)
  setup linux          Run Linux/VPS setup (setup-linux.sh)
  repos clone [file]   Bulk-clone repos from repos.txt (clone-repos.sh)
  server harden        Harden a VPS: Tailscale + UFW + auto-upgrades (harden-vps.sh)
  obsidian sync        Set up Obsidian headless sync (setup-obsidian-sync.sh)
  packages check       Report which manifest packages are installed vs missing
  agents inventory     List capability names without printing config values
  agents plan          Compare current capabilities with the cleanup policy
  agents check         Validate policy; assignments remain report-only
  claude hooks [flags] Wire claude-memory-compiler capture hooks into
                       ~/.claude/settings.json (--apply/--check/--dry-run;
                       see docs/claude-memory-compiler.md)
  pi doctor            Read-only checks for the opt-in Pi agent scaffold
  pi scaffold [flags]  Install the Pi scaffold -> ~/.pi (--apply/--force/--dry-run;
                      source: DOTFILES_PI_SCAFFOLD_DIR in local.env)
  pi profiles [flags]  Prepare/check personal + work profiles (--apply/--check/--dry-run)
  pi subagents [flags] Install/check pinned Pi subagents (--apply/--check/--dry-run)
  pi install           Install the pi CLI (opt-in; prompts before running)
  chezmoi <cmd> [...]  Thin passthrough to chezmoi (diff/apply/init/...). Only
                       read-only subcommands like `diff` are non-mutating.
                       Warns if chezmoi is absent.

Most setup/server commands are wrappers around the scripts of the same name;
run them directly if you prefer. See AGENTS.md for where to edit things.
EOF
}

packages_check() {
  local pdir="$DOT_ROOT/packages" any=0 pi_path="" pi_version=""
  echo "== packages check =="
  if command -v brew >/dev/null 2>&1 && [ -f "$DOT_ROOT/Brewfile" ]; then
    any=1; echo "-- Brewfile (brew bundle check) --"
    brew bundle check --file="$DOT_ROOT/Brewfile" || true
  fi
  if command -v dpkg >/dev/null 2>&1; then
    for m in apt.base apt.agent; do
      [ -f "$pdir/$m" ] || continue
      any=1; echo "-- $m --"
      while read -r pkg; do
        pkg="${pkg%%#*}"; pkg="$(echo "$pkg" | tr -d '[:space:]')"; [ -n "$pkg" ] || continue
        if dpkg -s "$pkg" >/dev/null 2>&1; then echo "  ok   $pkg"; else echo "  MISS $pkg"; fi
      done < "$pdir/$m"
    done
  fi
  if command -v npm >/dev/null 2>&1 && [ -f "$pdir/npm.global" ]; then
    any=1; echo "-- npm.global --"
    while read -r pkg; do
      pkg="${pkg%%#*}"; pkg="$(echo "$pkg" | tr -d '[:space:]')"; [ -n "$pkg" ] || continue
      if [ "$pkg" = "@earendil-works/pi-coding-agent@0.81.1" ]; then
        pi_path="$(command -v pi 2>/dev/null || true)"
        pi_version="$(pi --version 2>/dev/null || true)"
        case "$pi_path" in
          *"/.vite-plus/"*) echo "  MISS $pkg (Pi still uses Vite+ layout)" ;;
          "") echo "  MISS $pkg" ;;
          *)
            if [ "$pi_version" = "0.81.1" ]; then
              echo "  ok   $pkg ($pi_version)"
            else
              echo "  MISMATCH $pkg (active Pi: ${pi_version:-unknown} at $pi_path)"
            fi
            ;;
        esac
      elif npm ls -g --depth=0 "$pkg" >/dev/null 2>&1; then echo "  ok   $pkg"; else echo "  MISS $pkg"; fi
    done < "$pdir/npm.global"
  fi
  [ "$any" = 1 ] || echo "  (no package manager / manifests applicable on this host)"
}

pi_doctor() {  # read-only checks for the Pi agent scaffold; never writes
  local dest="${PI_HOME:-$HOME/.pi}" offender pi_bin pi_version scaffold
  echo "== pi doctor =="
  # The scaffold is not tracked in this public repo (unlicensed upstream; see
  # docs/licensing.md). Resolve it from local.env, falling back to a fork-local
  # templates/pi/ if one exists.
  declare -F load_local_env >/dev/null 2>&1 && { load_local_env || true; }
  scaffold="${DOTFILES_PI_SCAFFOLD_DIR:-$DOT_ROOT/templates/pi}"
  pi_bin="$(command -v pi 2>/dev/null || true)"
  if [ -z "$pi_bin" ] && [ -x "$HOME/.vite-plus/bin/pi" ]; then
    pi_bin="$HOME/.vite-plus/bin/pi"
  fi
  if [ -n "$pi_bin" ]; then
    pi_version="$("$pi_bin" --version 2>/dev/null || true)"
    case "$pi_bin" in
      *"/.vite-plus/"*) echo "  WARN Pi uses Vite+ layout; run ./dot pi install before subagents" ;;
      *)
        if [ "$pi_version" = "0.81.1" ]; then
          echo "  ok   pinned Pi CLI present: $pi_bin ($pi_version)"
        else
          echo "  WARN Pi version mismatch: expected 0.81.1, found ${pi_version:-unknown} at $pi_bin"
        fi
        ;;
    esac
  else echo "  --   pi CLI not installed (optional; ./dot pi install)"; fi
  if [ ! -f "$scaffold/package.json" ]; then
    echo "  --   scaffold source not configured (set DOTFILES_PI_SCAFFOLD_DIR in ~/.config/dotfiles/local.env)"
  else
    echo "  ok   scaffold present: $scaffold"
    [ -f "$scaffold/agent/skills/subagent-routing/SKILL.md" ] \
      && echo "  ok   direct-first subagent routing policy present" \
      || echo "  MISS subagent routing policy missing"
    [ -f "$scaffold/agent/agents/engineer.md" ] \
      && [ -f "$scaffold/agent/agents/architect.md" ] \
      && [ -f "$scaffold/agent/agents/analyst.md" ] \
      && [ -f "$scaffold/agent/agents/sol-reviewer.md" ] \
      && echo "  ok   task/model agent profiles present" \
      || echo "  MISS task/model agent profiles missing"
    [ -f "$scaffold/agent/subagents.json" ] \
      && [ -f "$scaffold/agent/agent-tool-description.md" ] \
      && echo "  ok   subagent defaults and tool guidance present" \
      || echo "  MISS subagent defaults or tool guidance missing"
  fi
  [ -f "$DOT_ROOT/scripts/setup-pi-subagents.sh" ] \
    && echo "  ok   pinned subagent installer present" \
    || echo "  MISS pinned subagent installer missing"
  if [ -f "$scaffold/package.json" ]; then
    [ -f "$scaffold/agent/pi-codex-compaction.json" ] \
      && grep -Fq 'npm:@ogulcancelik/pi-codex-compaction@0.1.0' \
        "$scaffold/agent/settings.example.json" \
      && echo "  ok   pinned Codex compaction config present" \
      || echo "  MISS pinned Codex compaction config missing"
    [ -f "$DOT_ROOT/scripts/setup-pi-profiles.sh" ] \
      && [ -f "$scaffold/agent/extensions/account-profile-indicator.ts" ] \
      && [ -f "$scaffold/agent/skills/coding-agent-account-routing/SKILL.md" ] \
      && [ -f "$scaffold/agent/models.work.example.json" ] \
      && [ -f "$DOT_ROOT/templates/hermes/skills/software-development/coding-agent-account-routing/SKILL.md" ] \
      && echo "  ok   personal/work profile assets present" \
      || echo "  MISS personal/work profile assets missing"
  fi
  if [ -d "$dest" ]; then
    echo "  ok   \$PI_HOME exists: $dest"
    [ -f "$dest/package.json" ] && echo "  ok   ~/.pi/package.json present" \
      || echo "  --   ~/.pi/package.json missing (run ./dot pi scaffold --apply)"
  else
    echo "  --   \$PI_HOME not present: $dest (opt-in; ./dot pi scaffold --apply)"
  fi
  # Guard: the scaffold's example files must not carry real secrets/private URLs.
  # Generic secret shapes are checked here; project-specific private endpoint/
  # token patterns stay in a local, gitignored blocklist so the public repo does
  # not enumerate them. See config/dotfiles/local.env.example (DOTFILES_PI_BLOCKLIST).
  local pattern blocklist rc=0 line lineno=0 grc valid_extra=""
  pattern='sk-ant-[A-Za-z0-9]|AKIA[0-9A-Z]{16}|xox[baprs]-[A-Za-z0-9-]+|-----BEGIN [A-Z ]*PRIVATE KEY-----'
  blocklist="${DOTFILES_PI_BLOCKLIST:-${XDG_CONFIG_HOME:-$HOME/.config}/dotfiles/pi-scaffold-blocklist.txt}"
  if [ -f "$blocklist" ]; then
    while IFS= read -r line || [ -n "$line" ]; do
      lineno=$((lineno+1))
      case "$line" in ''|[[:space:]]*'#'*|'#'*) continue ;; esac
      [ -n "${line//[[:space:]]/}" ] || continue
      # grep -E: 0 match, 1 no-match, >=2 error (invalid regex). Test against
      # empty input so only regex validity is exercised.
      grc=0
      printf '' | grep -E -- "$line" >/dev/null 2>&1 || grc=$?
      if [ "$grc" -ge 2 ]; then
        echo "  FAIL invalid regex in blocklist (line $lineno)"  # value not printed
        rc=1
      else
        valid_extra="${valid_extra:+$valid_extra|}$line"
      fi
    done < "$blocklist"
    [ -n "$valid_extra" ] && pattern="$pattern|$valid_extra"
  fi
  if [ ! -d "$scaffold" ]; then
    echo "  --   scaffold secret scan skipped (no scaffold source)"
    return "$rc"
  fi
  offender=$(grep -rIlE "$pattern" "$scaffold" 2>/dev/null || true)
  if [ -z "$offender" ]; then
    echo "  ok   scaffold free of known private strings/live secrets"
  else
    echo "  FAIL scaffold contains forbidden strings:"
    while IFS= read -r path; do
      [ -n "$path" ] && printf '        %s\n' "$path"
    done <<< "$offender"
    rc=1
  fi
  return "$rc"
}

chezmoi_wrap() {
  if ! command -v chezmoi >/dev/null 2>&1; then
    echo "dot: chezmoi is not installed. This repo does not use chezmoi yet;" >&2
    echo "     see docs/chezmoi-plan.md. Install: https://chezmoi.io" >&2
    exit 1
  fi
  [ $# -gt 0 ] || { echo "dot: chezmoi needs a subcommand (e.g. diff, apply, init)" >&2; exit 1; }
  exec chezmoi "$@"
}

cmd="${1:-help}"; shift || true
case "$cmd" in
  help|-h|--help) usage ;;
  doctor)         run scripts/doctor.sh "$@" ;;
  setup)
    case "${1:-}" in
      mac)   run setup.sh ;;
      linux) run setup-linux.sh ;;
      *) echo "dot: setup needs 'mac' or 'linux'" >&2; usage; exit 1 ;;
    esac ;;
  repos)
    case "${1:-}" in
      clone) shift; run clone-repos.sh "$@" ;;
      *) echo "dot: repos needs 'clone'" >&2; usage; exit 1 ;;
    esac ;;
  server)
    case "${1:-}" in
      harden) run harden-vps.sh ;;
      *) echo "dot: server needs 'harden'" >&2; usage; exit 1 ;;
    esac ;;
  obsidian)
    case "${1:-}" in
      sync) run setup-obsidian-sync.sh ;;
      *) echo "dot: obsidian needs 'sync'" >&2; usage; exit 1 ;;
    esac ;;
  packages)
    case "${1:-}" in
      check) packages_check ;;
      *) echo "dot: packages needs 'check'" >&2; usage; exit 1 ;;
    esac ;;
  agents)
    case "${1:-}" in
      inventory|plan|check) run scripts/manage-agents.sh "$@" ;;
      *) echo "dot: agents needs 'inventory', 'plan', or 'check'" >&2; usage; exit 1 ;;
    esac ;;
  claude)
    case "${1:-}" in
      hooks) shift; run scripts/setup-claude-memory-hooks.sh "$@" ;;
      *) echo "dot: claude needs 'hooks'" >&2; usage; exit 1 ;;
    esac ;;
  pi)
    case "${1:-}" in
      doctor)    pi_doctor ;;
      scaffold)  shift; run scripts/setup-pi-agent.sh "$@" ;;
      profiles)  shift; run scripts/setup-pi-profiles.sh "$@" ;;
      subagents) shift; run scripts/setup-pi-subagents.sh "$@" ;;
      install)   run scripts/setup-pi-agent.sh --install ;;
      *) echo "dot: pi needs 'doctor', 'scaffold', 'profiles', 'subagents', or 'install'" >&2; usage; exit 1 ;;
    esac ;;
  chezmoi) chezmoi_wrap "$@" ;;
  *) echo "dot: unknown command: $cmd" >&2; usage; exit 1 ;;
esac
